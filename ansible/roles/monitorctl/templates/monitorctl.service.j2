[Unit]
Description=monitorctl — DDC/CI monitor control
Documentation=https://github.com/DimpiM/monitor-switch
After=network-online.target
Wants=network-online.target
# The monitor may simply be switched off at boot. Keep retrying rather than
# giving up after the default burst limit. This belongs in [Unit] — systemd
# ignores it in [Service] and says so in the journal.
StartLimitIntervalSec=0

[Service]
Type=simple
User={{ monitorctl_user }}
Group={{ monitorctl_group }}
# Membership in i2c is what makes running unprivileged possible at all.
SupplementaryGroups=i2c
WorkingDirectory={{ monitorctl_install_dir }}
Environment=MONITORCTL_CONFIG={{ monitorctl_config_dir }}/config.yaml
Environment=PYTHONUNBUFFERED=1
# ddcutil keeps a dynamic-sleep-adjustment cache under $XDG_CACHE_HOME (falling
# back to $HOME/.cache). ProtectSystem=strict makes the install directory
# read-only, so without somewhere writable it logs an error on every single
# invocation and loses the timing data it uses to adapt.
# CacheDirectory creates /var/cache/monitorctl owned by this service.
CacheDirectory=monitorctl
Environment=XDG_CACHE_HOME=/var/cache/monitorctl
# Secrets live here, not in the world-readable config file. "-" so the service
# still starts when MQTT is not configured.
EnvironmentFile=-{{ monitorctl_config_dir }}/env
ExecStart=/usr/bin/python3 {{ monitorctl_install_dir }}/run.py

Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
# ddcutil needs the I²C character device; sysfs is read for the connector state.
DeviceAllow=char-i2c rw
ReadWritePaths=

[Install]
WantedBy=multi-user.target
